#!/usr/bin/env bash
# trellis-grok — quick deploy / manage the Trellis + Matt Grok fixes.
#
#   trellis-grok status  [DIR]
#   trellis-grok dry-run [DIR]
#   trellis-grok apply   [DIR]
#   trellis-grok revert  [DIR]
#   trellis-grok init    [DIR] [-u NAME] [--claude] [--codex] [...]
#   trellis-grok install [DIR] [-u NAME] [--claude] [--codex] [--grok]
#                        [--from-github] [--no-skills]
#   trellis-grok update  [DIR] [--allow-workflow]
#   trellis-grok --help
#
# TRELLIS_GROK_HOME overrides the source checkout (default: resolve to the
# clone that contains scripts/grok-fixes, usually ~/trellis).
# install --from-github clones TRELLIS_GROK_REPO (default:
# https://github.com/samiya782/trellis-workflow.git) branch TRELLIS_GROK_BRANCH
# (default: grok) into TRELLIS_GROK_CLONE_DIR (default:
# $XDG_CACHE_HOME/trellis-grok/workflow or ~/.cache/trellis-grok/workflow)
# and uses that clone as the file source.
#
# Exit codes (aligned with apply-grok-fixes.sh where applicable):
#   0  OK
#   2  usage / not a Trellis project / missing home
#   3  version mismatch (from apply script)
#   4  patch conflict (from apply script)
#   other  apply/smoke/tests/trellis CLI failure
set -euo pipefail

resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local dir; dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd "$(dirname "$src")" && pwd
}

SCRIPT_DIR="$(resolve_self)"

resolve_home() {
  if [[ -n "${TRELLIS_GROK_HOME:-}" ]]; then
    local h; h="$(cd "$TRELLIS_GROK_HOME" && pwd)"
    [[ -x "$h/scripts/grok-fixes/apply-grok-fixes.sh" ]] || {
      echo "error: TRELLIS_GROK_HOME=$h has no scripts/grok-fixes/apply-grok-fixes.sh" >&2
      exit 2
    }
    echo "$h"; return
  fi
  # Script lives at <home>/scripts/grok-fixes/trellis-grok
  if [[ -x "$SCRIPT_DIR/apply-grok-fixes.sh" ]]; then
    cd "$SCRIPT_DIR/../.." && pwd; return
  fi
  if [[ -x "$HOME/trellis/scripts/grok-fixes/apply-grok-fixes.sh" ]]; then
    echo "$HOME/trellis"; return
  fi
  echo "error: cannot find Trellis+Grok checkout. Set TRELLIS_GROK_HOME or install via scripts/grok-fixes/install-shortcut.sh" >&2
  exit 2
}

HOME_SRC="$(resolve_home)"
APPLY="$HOME_SRC/scripts/grok-fixes/apply-grok-fixes.sh"

usage() {
  cat <<USAGE
trellis-grok — quick deploy the modified Trellis + Matt Grok version

Source: $HOME_SRC
Override with TRELLIS_GROK_HOME=/path/to/checkout

Usage:
  trellis-grok status  [DIR]     Trellis version + which patches are applied
  trellis-grok dry-run [DIR]     Preview apply (no writes)
  trellis-grok apply   [DIR]     Sync Matt/workflow/commands + script patches
  trellis-grok revert  [DIR]     Revert applied patches
  trellis-grok init    [DIR] [-u NAME] [trellis-init-flags...]
                                 New project: trellis init --grok, copy Matt docs
                                 + workflow, apply fixes. Does not install Matt
                                 skills. Extra flags (including --claude/--codex)
                                 are passed through to trellis init.
  trellis-grok install [DIR] [-u NAME] [--claude] [--codex] [--grok]
                                 [--from-github] [--no-skills]
                                 [trellis-init-flags...]
                                 One-click: trellis init for the requested
                                 platforms, copy this checkout's overlays,
                                 install Matt skills, apply script fixes.
                                 No platform flags means all three.
                                 --from-github clones branch grok and copies
                                 from that clone. --no-skills skips npx skills.
  trellis-grok update  [DIR] [--allow-workflow]
                                 Safe update: trellis update -n, re-apply fixes,
                                 list .new merges; protect .trellis/workflow.md
                                 unless --allow-workflow
  trellis-grok --help

DIR defaults to the current directory (or git toplevel when inside a repo
for status/dry-run/apply/revert/update). install/init default to the current
directory and refuse to run inside the source checkout.
Idempotent: re-apply is a no-op when already patched. install on an existing
Trellis project skips trellis init and re-syncs overlays.
USAGE
  exit "${1:-0}"
}

resolve_dir() {
  local d="${1:-}"
  if [[ -z "$d" ]]; then
    d="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  fi
  [[ -d "$d" ]] || { echo "error: directory not found: $d" >&2; exit 2; }
  cd "$d" && pwd
}

require_trellis() {
  local d="$1"
  [[ -f "$d/.trellis/scripts/task.py" ]] || {
    echo "error: $d is not a Trellis project (.trellis/scripts/task.py missing)" >&2
    exit 2
  }
}

cmd_status() {
  local d; d="$(resolve_dir "${1:-}")"
  require_trellis "$d"
  local version
  version="$(tr -d ' \n\r' < "$d/.trellis/.version" 2>/dev/null || echo unknown)"
  echo "target:  $d"
  echo "trellis: $version"
  echo "source:  $HOME_SRC"
  echo "patches:"
  local p name state
  for p in "$HOME_SRC"/scripts/grok-fixes/patches/000*.patch; do
    [[ -f "$p" ]] || continue
    name="$(basename "$p")"
    case "$name" in
      0003*)
        if [[ ! -d "$d/.grok/commands" ]]; then
          printf '  %-42s %s\n' "$name" "skipped (no .grok/commands)"
          continue
        fi
        ;;
      0004*)
        if [[ ! -f "$d/docs/agents/matt-flow.md" ]]; then
          printf '  %-42s %s\n' "$name" "skipped (no matt-flow.md)"
          continue
        fi
        ;;
    esac
    if git -C "$d" apply --check -R --whitespace=nowarn "$p" 2>/dev/null; then
      state=applied
    elif git -C "$d" apply --check --whitespace=nowarn "$p" 2>/dev/null; then
      state=pending
    else
      state=conflict
    fi
    printf '  %-42s %s\n' "$name" "$state"
  done
  echo "sync (source vs target; apply copies these):"
  local rel
  for rel in .trellis/workflow.md docs/agents/matt-flow.md docs/agents/issue-tracker.md \
             .grok/commands/trellis-start.md .grok/commands/trellis-continue.md \
             .grok/commands/trellis-finish-work.md; do
    if [[ ! -f "$HOME_SRC/$rel" ]]; then
      continue
    fi
    if [[ ! -f "$d/$rel" ]]; then
      printf '  %-42s %s\n' "$rel" "missing"
    elif cmp -s "$HOME_SRC/$rel" "$d/$rel"; then
      printf '  %-42s %s\n' "$rel" "in-sync"
    else
      printf '  %-42s %s\n' "$rel" "stale"
    fi
  done
  for label in "AGENTS.md" "CLAUDE.md"; do
    if [[ -f "$d/$label" ]] && grep -qF "On \`/grill-with-docs\`" "$d/$label" 2>/dev/null; then
      printf '  %-42s %s\n' "$label Matt/grill block" "present"
    elif [[ -f "$d/$label" ]]; then
      printf '  %-42s %s\n' "$label Matt/grill block" "missing"
    else
      printf '  %-42s %s\n' "$label Matt/grill block" "absent"
    fi
  done
}

cmd_dry_run() {
  local d; d="$(resolve_dir "${1:-}")"
  require_trellis "$d"
  echo "--- sync preview (no writes)"
  sync_integration "$d" --dry-run
  echo "--- patch dry-run (scripts only; grok-layer is copy-synced on apply)"
  "$APPLY" --dry-run --target "$d" --only scripts
}

cmd_apply() {
  local d; d="$(resolve_dir "${1:-}")"
  require_trellis "$d"
  echo "--- sync Grok/Matt integration from $HOME_SRC"
  sync_integration "$d"
  # Script patches only: grok-layer files are copy-synced above. Evolving
  # 0003/0004 against already-synced files would false-conflict.
  echo "--- apply script patches (0001-0002)"
  "$APPLY" --target "$d" --only scripts
}

cmd_revert() {
  local d; d="$(resolve_dir "${1:-}")"
  require_trellis "$d"
  "$APPLY" --revert --target "$d" --no-tests
}

sync_integration() {
  local d="$1"
  local dry=0
  [[ "${2:-}" == "--dry-run" ]] && dry=1
  local f
  for f in .trellis/workflow.md docs/agents/matt-flow.md docs/agents/issue-tracker.md; do
    if [[ ! -f "$HOME_SRC/$f" ]]; then
      echo "  skip missing source: $f"
      continue
    fi
    if [[ -f "$d/$f" ]] && cmp -s "$HOME_SRC/$f" "$d/$f"; then
      echo "  in-sync: $f"
      continue
    fi
    if [[ $dry -eq 1 ]]; then
      echo "  would copy: $f"
      continue
    fi
    mkdir -p "$d/$(dirname "$f")"
    cp -p "$HOME_SRC/$f" "$d/$f"
    echo "  copied: $f"
  done
  if [[ -d "$d/.grok/commands" ]]; then
    for f in trellis-start.md trellis-continue.md trellis-finish-work.md; do
      if [[ ! -f "$HOME_SRC/.grok/commands/$f" ]]; then
        continue
      fi
      if [[ -f "$d/.grok/commands/$f" ]] && cmp -s "$HOME_SRC/.grok/commands/$f" "$d/.grok/commands/$f"; then
        echo "  in-sync: .grok/commands/$f"
        continue
      fi
      if [[ $dry -eq 1 ]]; then
        echo "  would copy: .grok/commands/$f"
        continue
      fi
      cp -p "$HOME_SRC/.grok/commands/$f" "$d/.grok/commands/$f"
      echo "  copied: .grok/commands/$f"
    done
  fi
  if [[ -f "$d/.claude/settings.json" && -f "$HOME_SRC/.claude/settings.json" ]]; then
    if [[ $dry -eq 1 ]]; then
      if python3 - "$d/.claude/settings.json" "$HOME_SRC/.claude/settings.json" <<'PY'
import json,sys
t=json.load(open(sys.argv[1])); s=json.load(open(sys.argv[2]))
tm={h.get("matcher") for h in t.get("hooks",{}).get("SessionStart",[])}
need={"new","load"}
raise SystemExit(0 if need <= tm else 1)
PY
      then echo "  in-sync: .claude/settings.json SessionStart new|load"
      else echo "  would merge: .claude/settings.json SessionStart new|load"
      fi
    else
      python3 - "$d/.claude/settings.json" "$HOME_SRC/.claude/settings.json" <<'PY'
import json,sys
from pathlib import Path
target, source = Path(sys.argv[1]), Path(sys.argv[2])
t=json.loads(target.read_text()); s=json.loads(source.read_text())
th=t.setdefault("hooks",{}).setdefault("SessionStart",[])
sh=s.get("hooks",{}).get("SessionStart",[])
have={h.get("matcher") for h in th}
added=[]
for block in sh:
    m=block.get("matcher")
    if m in ("new","load") and m not in have:
        th.append(block); have.add(m); added.append(m)
if added:
    target.write_text(json.dumps(t, indent=2) + "\n")
    print("  merged: .claude/settings.json SessionStart " + "|".join(added))
else:
    print("  in-sync: .claude/settings.json SessionStart new|load")
PY
    fi
  fi
  # Grok Build injects project CLAUDE.md into agents_md_files (not AGENTS.md).
  # Keep AGENTS.md for Claude Code; also upsert the same Matt/grill block into CLAUDE.md.
  upsert_matt_file() {
    local target="$1"
    local label="$2"
    if [[ ! -f "$target" ]]; then
      if [[ $dry -eq 1 ]]; then
        echo "  would create: $label Matt/grill block"
        return
      fi
      mkdir -p "$(dirname "$target")"
      python3 - "$target" "$label" <<'PY'
import sys
from pathlib import Path
path = Path(sys.argv[1])
label = sys.argv[2]
block = """<!-- TRELLIS-GROK:MATT-START -->
For work in this project, load the compact workflow with
`python3 .trellis/scripts/get_context.py --mode phase` before choosing a route.
It governs local orchestration even when bundled skill examples prescribe extra
stages. Matt entry/resume details: `docs/agents/matt-flow.md`; publication:
`docs/agents/issue-tracker.md`.
A user-invoked Matt skill such as `grill-me` is not edit authority: once it settles
buildable scope, end with the exact next command (`/implement <scope>`, Codex
`$implement <scope>`) and pause.
On `/grill-with-docs`, before the first interview question: run
`python3 .trellis/scripts/get_context.py` and `--mode phase`, then create or reuse
a planning task with `task.py create … --no-start`, and write settled decisions
into that task as you grill (see `docs/agents/matt-flow.md`). Do not grill with
no task when a recoverable record is wanted.
When the user types `/implement` for a Trellis task still in `planning`, its
first action is workflow 1.4: run `python3 .trellis/scripts/task.py start <task>`
and confirm `task.py current --source` names the task, before any product edit
or worker. An approval or authorization message does not replace the command.
<!-- TRELLIS-GROK:MATT-END -->
"""
path.write_text(block)
print(f"  created: {label} Matt/grill block")
PY
      return
    fi
    if [[ $dry -eq 1 ]]; then
      if grep -qF "<!-- TRELLIS-GROK:MATT-START -->" "$target" 2>/dev/null && grep -qF "On \`/grill-with-docs\`" "$target" 2>/dev/null; then
        echo "  in-sync: $label Matt/grill block"
      elif grep -qF "On \`/grill-with-docs\`" "$target" 2>/dev/null; then
        echo "  in-sync: $label (already has grill-with-docs bootstrap)"
      else
        echo "  would upsert: $label Matt/grill block"
      fi
      return
    fi
    python3 - "$target" "$label" <<'PY'
import sys
from pathlib import Path
path = Path(sys.argv[1])
label = sys.argv[2]
text = path.read_text()
start = "<!-- TRELLIS-GROK:MATT-START -->"
end = "<!-- TRELLIS-GROK:MATT-END -->"
block = """<!-- TRELLIS-GROK:MATT-START -->
For work in this project, load the compact workflow with
`python3 .trellis/scripts/get_context.py --mode phase` before choosing a route.
It governs local orchestration even when bundled skill examples prescribe extra
stages. Matt entry/resume details: `docs/agents/matt-flow.md`; publication:
`docs/agents/issue-tracker.md`.
A user-invoked Matt skill such as `grill-me` is not edit authority: once it settles
buildable scope, end with the exact next command (`/implement <scope>`, Codex
`$implement <scope>`) and pause.
On `/grill-with-docs`, before the first interview question: run
`python3 .trellis/scripts/get_context.py` and `--mode phase`, then create or reuse
a planning task with `task.py create … --no-start`, and write settled decisions
into that task as you grill (see `docs/agents/matt-flow.md`). Do not grill with
no task when a recoverable record is wanted.
When the user types `/implement` for a Trellis task still in `planning`, its
first action is workflow 1.4: run `python3 .trellis/scripts/task.py start <task>`
and confirm `task.py current --source` names the task, before any product edit
or worker. An approval or authorization message does not replace the command.
<!-- TRELLIS-GROK:MATT-END -->"""
if start in text and end in text:
    pre, rest = text.split(start, 1)
    _, post = rest.split(end, 1)
    # A file that is only this block (what create writes) must stay byte-stable.
    # pre.rstrip() would turn a leading blank line into another rewrite.
    if pre.strip() == "":
        new = block + "\n" + post.lstrip("\n")
    else:
        new = pre.rstrip() + "\n\n" + block + "\n" + post.lstrip("\n")
    action = "updated"
elif "On `/grill-with-docs`" in text and "docs/agents/matt-flow.md" in text:
    print(f"  in-sync: {label} (already has grill-with-docs bootstrap)")
    raise SystemExit(0)
else:
    new = text.rstrip() + "\n\n" + block + "\n"
    action = "appended"
if new != text:
    path.write_text(new)
    print(f"  {action}: {label} Matt/grill block")
else:
    print(f"  in-sync: {label} Matt/grill block")
PY
  }
  upsert_matt_file "$d/AGENTS.md" "AGENTS.md"
  upsert_matt_file "$d/CLAUDE.md" "CLAUDE.md"
}


# Back-compat name used by init
copy_integration() {
  sync_integration "$@"
}

# Copy one repo-relative file from HOME_SRC onto the target. Missing sources
# are skipped. Identical files are left in place.
copy_overlay_file() {
  local rel="$1" d="$2"
  local dest="$d/$rel"
  if [[ ! -f "$HOME_SRC/$rel" ]]; then
    echo "  skip missing source: $rel"
    return 0
  fi
  # Replace symlinks instead of following them. cp would otherwise write
  # through a link and could change a file outside the project.
  if [[ -e "$dest" && ! -L "$dest" ]] && cmp -s "$HOME_SRC/$rel" "$dest"; then
    echo "  in-sync: $rel"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  rm -f "$dest"
  cp -p "$HOME_SRC/$rel" "$dest"
  echo "  copied: $rel"
}

# Platform overlays from the README copy list. Shared script fixes are always
# copied. Claude / Codex / Grok files are copied only for the platforms named
# on this install. .agents/skills/trellis-* are the Codex skill surface.
copy_platform_overlay() {
  local d="$1" claude="$2" codex="$3" grok="$4"
  local rel base f
  for rel in \
    .trellis/scripts/common/active_task.py \
    .trellis/scripts/common/task_store.py
  do
    copy_overlay_file "$rel" "$d"
  done
  if [[ "$claude" -eq 1 ]]; then
    for rel in \
      .claude/hooks/session-start.py \
      .claude/hooks/inject-subagent-context.py \
      .claude/commands/trellis/continue.md \
      .claude/commands/trellis/finish-work.md
    do
      copy_overlay_file "$rel" "$d"
    done
  fi
  if [[ "$codex" -eq 1 ]]; then
    for rel in \
      .codex/config.toml \
      .codex/hooks/session-start.py \
      .codex/hooks/inject-subagent-context.py \
      .codex/agents/trellis-check.toml \
      .codex/agents/trellis-implement.toml \
      .codex/agents/trellis-research.toml \
      .agents/skills/trellis-start/SKILL.md \
      .agents/skills/trellis-continue/SKILL.md \
      .agents/skills/trellis-finish-work/SKILL.md
    do
      copy_overlay_file "$rel" "$d"
    done
  fi
  if [[ "$grok" -eq 1 && -d "$HOME_SRC/.grok/commands" ]]; then
    for f in "$HOME_SRC"/.grok/commands/trellis-*.md; do
      [[ -f "$f" ]] || continue
      base="$(basename "$f")"
      copy_overlay_file ".grok/commands/$base" "$d"
    done
  fi
}

clone_github_source() {
  local repo="${TRELLIS_GROK_REPO:-https://github.com/samiya782/trellis-workflow.git}"
  local branch="${TRELLIS_GROK_BRANCH:-grok}"
  local dest="${TRELLIS_GROK_CLONE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/trellis-grok/workflow}"
  local url
  if [[ -e "$dest" && ! -d "$dest/.git" ]]; then
    echo "error: $dest exists and is not a git checkout. Set TRELLIS_GROK_CLONE_DIR or remove it." >&2
    exit 2
  fi
  if [[ ! -d "$dest/.git" ]]; then
    mkdir -p "$(dirname "$dest")"
    echo "--- clone $repo branch $branch -> $dest" >&2
    git clone --depth 1 --branch "$branch" "$repo" "$dest"
  else
    url="$(git -C "$dest" remote get-url origin 2>/dev/null || true)"
    case "$url" in
      "$repo"|"${repo%.git}"|"${repo}.git") ;;
      *)
        echo "error: $dest origin is '$url', expected $repo" >&2
        exit 2
        ;;
    esac
    if [[ -n "$(git -C "$dest" status --porcelain)" ]]; then
      echo "error: $dest has local changes. Remove it or set TRELLIS_GROK_CLONE_DIR to a fresh path." >&2
      exit 2
    fi
    echo "--- fetch $repo branch $branch in $dest" >&2
    git -C "$dest" fetch --depth 1 origin "$branch"
    git -C "$dest" checkout -q --detach FETCH_HEAD
  fi
  [[ -x "$dest/scripts/grok-fixes/apply-grok-fixes.sh" ]] || {
    echo "error: $dest has no scripts/grok-fixes/apply-grok-fixes.sh" >&2
    exit 2
  }
  (cd "$dest" && pwd)
}

install_matt_skills() {
  local d="$1" no_skills="$2" claude="$3" codex="$4" grok="$5"
  local -a agents=()
  if [[ "$no_skills" -eq 1 ]]; then
    echo "--- skip Matt skills (--no-skills)"
    return 0
  fi
  command -v npx >/dev/null 2>&1 || {
    echo "error: npx not found; install Node.js or re-run with --no-skills" >&2
    exit 2
  }
  [[ "$claude" -eq 1 ]] && agents+=(claude-code)
  [[ "$codex" -eq 1 ]] && agents+=(codex)
  [[ "$grok" -eq 1 ]] && agents+=(grok)
  if [[ ${#agents[@]} -eq 0 ]]; then
    echo "--- skip Matt skills (no platforms)"
    return 0
  fi
  echo "--- npx skills@latest add mattpocock/skills --agent ${agents[*]} --yes"
  (cd "$d" && npx --yes skills@latest add mattpocock/skills --agent "${agents[@]}" --yes)
}

cmd_install() {
  local d="" user="" from_github=0 no_skills=0
  local want_claude=0 want_codex=0 want_grok=0 platform_set=0
  local -a extra=() replay=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--user)
        [[ $# -ge 2 ]] || { echo "error: $1 needs a value" >&2; exit 2; }
        user="$2"; replay+=("$1" "$2"); shift 2; continue
        ;;
      --claude) want_claude=1; platform_set=1; replay+=("$1"); shift; continue ;;
      --codex) want_codex=1; platform_set=1; replay+=("$1"); shift; continue ;;
      --grok) want_grok=1; platform_set=1; replay+=("$1"); shift; continue ;;
      --from-github) from_github=1; shift; continue ;;
      --no-skills) no_skills=1; replay+=("$1"); shift; continue ;;
      -h|--help) usage 0 ;;
      -t|--template|-r|--registry|--workflow|--workflow-source)
        [[ $# -ge 2 ]] || { echo "error: $1 needs a value" >&2; exit 2; }
        extra+=("$1" "$2"); replay+=("$1" "$2"); shift 2; continue
        ;;
      -*)
        extra+=("$1"); replay+=("$1"); shift; continue
        ;;
      *)
        if [[ -z "$d" ]]; then d="$1"; else extra+=("$1"); fi
        replay+=("$1"); shift; continue
        ;;
    esac
  done
  if [[ $from_github -eq 1 ]]; then
    local src
    src="$(clone_github_source)" || exit $?
    echo "github source: $src"
    exec env TRELLIS_GROK_HOME="$src" "$0" install "${replay[@]}"
  fi
  if [[ $platform_set -eq 0 ]]; then
    want_claude=1; want_codex=1; want_grok=1
    echo "install: no platform flags; using --claude --codex --grok"
  fi
  if [[ -n "$d" ]]; then
    mkdir -p "$d"
    d="$(cd "$d" && pwd)"
  else
    d="$(pwd)"
  fi
  local script_home
  script_home="$(cd "$SCRIPT_DIR/../.." && pwd)"
  if [[ "$d" == "$HOME_SRC" || "$d" == "$script_home" ]]; then
    echo "error: refusing to install into the Trellis source checkout ($d)" >&2
    echo "       pass a new project directory. Use apply/update inside this checkout." >&2
    exit 2
  fi
  if [[ -z "$user" ]]; then
    user="${TRELLIS_GROK_USER:-${USER:-developer}}"
    echo "install: using -u $user (override with -u NAME or TRELLIS_GROK_USER)"
  fi
  command -v trellis >/dev/null 2>&1 || {
    echo "error: trellis CLI not found on PATH" >&2
    exit 2
  }
  echo "source checkout: $HOME_SRC"
  echo "target: $d"
  local -a platforms=()
  [[ $want_claude -eq 1 ]] && platforms+=(--claude)
  [[ $want_codex -eq 1 ]] && platforms+=(--codex)
  [[ $want_grok -eq 1 ]] && platforms+=(--grok)
  if [[ -d "$d/.trellis" ]]; then
    echo "--- .trellis exists; skipping trellis init"
  else
    if ! git -C "$d" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      git -C "$d" init
      echo "  git init: $d"
    fi
    echo "--- trellis init -u $user -y ${platforms[*]:-} ${extra[*]:-}"
    (cd "$d" && trellis init -u "$user" -y ${platforms[@]+"${platforms[@]}"} ${extra[@]+"${extra[@]}"})
  fi
  echo "--- Matt skills"
  install_matt_skills "$d" "$no_skills" "$want_claude" "$want_codex" "$want_grok"
  echo "--- copy platform overlays from $HOME_SRC"
  copy_platform_overlay "$d" "$want_claude" "$want_codex" "$want_grok"
  echo "--- sync workflow, Matt docs, Grok commands, AGENTS.md, CLAUDE.md"
  sync_integration "$d"
  echo "--- apply script patches (0001-0002)"
  "$APPLY" --target "$d" --only scripts
  echo "install done: $d"
  echo "platforms: ${platforms[*]:-(none)}"
  if [[ $want_grok -eq 1 ]]; then
    echo "Next for Grok: grok --trust   (once, in the project)"
  fi
}

cmd_init() {
  local d="" user="" extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--user)
        [[ $# -ge 2 ]] || { echo "error: $1 needs a value" >&2; exit 2; }
        user="$2"; shift 2; continue
        ;;
      -h|--help) usage 0 ;;
      -t|--template|-r|--registry|--workflow|--workflow-source)
        [[ $# -ge 2 ]] || { echo "error: $1 needs a value" >&2; exit 2; }
        extra+=("$1" "$2"); shift 2; continue
        ;;
      -*)
        extra+=("$1"); shift; continue
        ;;
      *)
        if [[ -z "$d" ]]; then d="$1"; else extra+=("$1"); fi
        shift; continue
        ;;
    esac
  done
  if [[ -n "$d" ]]; then
    mkdir -p "$d"
    d="$(cd "$d" && pwd)"
  else
    d="$(pwd)"
  fi
  if [[ -z "$user" ]]; then
    user="${TRELLIS_GROK_USER:-${USER:-developer}}"
    echo "init: using -u $user (override with -u NAME or TRELLIS_GROK_USER)"
  fi
  if [[ -d "$d/.trellis" ]]; then
    echo "error: $d already has .trellis/; use apply/update, or pass -f/-s through to trellis init" >&2
    exit 2
  fi
  if ! git -C "$d" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$d" init
    echo "  git init: $d"
  fi
  echo "--- trellis init -u $user --grok -y ${extra[*]:-}"
  (cd "$d" && trellis init -u "$user" --grok -y ${extra[@]+"${extra[@]}"})
  echo "--- copy Matt + workflow integration from $HOME_SRC"
  copy_integration "$d"
  echo "--- apply script patches (0001-0002)"
  "$APPLY" --target "$d" --only scripts
  echo "init done: $d"
  echo "Next: npx skills@latest add mattpocock/skills --agent grok --yes"
  echo "      then: grok --trust   (once, in the project)"
}

cmd_update() {
  local d="" allow_workflow=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --allow-workflow) allow_workflow=1; shift ;;
      -h|--help) usage 0 ;;
      -*)
        echo "unknown option for update: $1" >&2; usage 2 ;;
      *)
        if [[ -z "$d" ]]; then d="$1"; shift
        else echo "unexpected: $1" >&2; usage 2; fi
        ;;
    esac
  done
  d="$(resolve_dir "${d:-}")"
  require_trellis "$d"
  local wf="$d/.trellis/workflow.md"
  local wf_bak=""
  if [[ -f "$wf" && $allow_workflow -eq 0 ]]; then
    wf_bak="$(mktemp)"
    cp -p "$wf" "$wf_bak"
  fi
  echo "--- trellis update -n (create .new; no overwrite) in $d"
  echo "    workflow.md protection: $([[ $allow_workflow -eq 1 ]] && echo off || echo on)"
  if ! (cd "$d" && trellis update -n); then
    [[ -n "$wf_bak" ]] && rm -f "$wf_bak"
    echo "error: trellis update -n failed" >&2
    exit 1
  fi
  if [[ -n "$wf_bak" ]]; then
    if ! cmp -s "$wf_bak" "$wf" 2>/dev/null; then
      echo "warning: .trellis/workflow.md changed; restoring protected copy" >&2
      cp -p "$wf_bak" "$wf"
      echo "  restored: .trellis/workflow.md"
    fi
    rm -f "$wf_bak"
  fi
  echo "--- .new files needing manual merge:"
  local found=0
  while IFS= read -r -d '' f; do
    found=1
    local rel="${f#"$d"/}"
    echo "  $rel"
    case "$rel" in
      .trellis/workflow.md.new)
        echo "    (workflow.md protected by default; compare then delete .new)"
        ;;
    esac
  done < <(find "$d" \( -name '*.new' -o -name '*.NEW' \) -print0 2>/dev/null)
  if [[ $found -eq 0 ]]; then
    echo "  (none)"
  fi
  echo "--- sync + re-apply grok fixes"
  set +e
  sync_integration "$d"
  "$APPLY" --target "$d" --only scripts
  local rc=$?
  set -e
  if [[ $rc -eq 3 ]]; then
    echo "note: version mismatch after update. See docs/grok-fixes/INSTALL.md;" >&2
    echo "      dry-run then apply-grok-fixes.sh --force-version if context still matches." >&2
    exit 3
  elif [[ $rc -ne 0 ]]; then
    exit "$rc"
  fi
  echo "update path done. Merge any .new files by hand, then delete them."
}

[[ $# -eq 0 ]] && usage 2
cmd="${1:-}"; shift || true
case "$cmd" in
  -h|--help|help) usage 0 ;;
  status)  cmd_status "$@" ;;
  dry-run|dryrun) cmd_dry_run "$@" ;;
  apply)   cmd_apply "$@" ;;
  revert)  cmd_revert "$@" ;;
  init)    cmd_init "$@" ;;
  install) cmd_install "$@" ;;
  update)  cmd_update "$@" ;;
  *)
    echo "unknown command: $cmd" >&2
    usage 2
    ;;
esac
