 .trellis/scripts/common/task_store.py  |  48 +++++++++++
 tests/test_grok_fixes.py               | 110 +++++++++++++++++++++++++
 tests/test_integration.py              |  15 ++--
 4 files changed, 171 insertions(+), 5 deletions(-)
 create mode 100755 tests/test_grok_fixes.py

